{
  "llm_model": "qwen2.5-coder-14b-instruct",
  "embedding_model": "nomic-embed",
  "lm_studio_url": "http://127.0.0.1:1234/v1",
  "seed": 42,
  "candidate_pool": 110,
  "ground_truth_pairs": 10,
  "queries": 10,
